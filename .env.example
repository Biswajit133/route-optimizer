# Copy to .env and fill in. .env is gitignored - this repo is public, so real
# credentials must never be committed here.
# Only training reads the DB ones; the Flask endpoints take JSON and never touch it.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Needed only by delay_prediction.py serving, for the live traffic ETA.
GOOGLE_MAPS_API_KEY=

# Same JWT_SECRET as orders/.env - used to verify the caller token and read
# customer_id from it. Must match, or every request is rejected as invalid.
JWT_SECRET=

# Comma-separated list of browser origins allowed to call app.py directly
# (Angular, etc). Defaults to http://localhost:4200 if left blank.
CORS_ORIGINS=http://localhost:4200,http://13.233.65.86,https://lab.observancedev.com
